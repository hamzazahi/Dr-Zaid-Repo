{
  "info": {
    "name": "DentSuite API (Supabase)",
    "description": "All DentSuite backend endpoints. SETUP: 1) set the `anon_key` collection variable (copy VITE_SUPABASE_ANON_KEY from .env), 2) run 'Auth > Sign in (doctor)' — it auto-saves the JWT into `access_token` for every other request. Full docs: API.md in the repo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://bipkrvxwfrqurawltqem.supabase.co" },
    { "key": "anon_key", "value": "PASTE_VITE_SUPABASE_ANON_KEY_FROM_.env" },
    { "key": "access_token", "value": "" },
    { "key": "patient_id", "value": "30000000-0000-0000-0000-000000000001" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign in (doctor) — run me first",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.access_token) { pm.collectionVariables.set('access_token', j.access_token); console.log('access_token saved'); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/auth/v1/token?grant_type=password",
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"admin@drzaiddental.com\", \"password\": \"Test@123\" }",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Sign in (receptionist) — for RLS tests",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.access_token) { pm.collectionVariables.set('access_token', j.access_token); console.log('access_token saved (receptionist)'); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/auth/v1/token?grant_type=password",
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"reception@drzaiddental.com\", \"password\": \"Test@123\" }",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "My profile (role check)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/rest/v1/profiles?select=*"
          }
        },
        {
          "name": "Sign out",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/auth/v1/logout"
          }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "List patients",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/rest/v1/patients?select=*&order=created_at.desc"
          }
        },
        {
          "name": "Search by name (ilike)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/rest/v1/patients?name=ilike.*ali*&select=id,name,phone,status"
          }
        },
        {
          "name": "Get one by id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/rest/v1/patients?id=eq.{{patient_id}}"
          }
        },
        {
          "name": "Create patient",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Prefer", "value": "return=representation" }
            ],
            "url": "{{base_url}}/rest/v1/patients",
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"Postman Test Patient\", \"gender\": \"Male\", \"dob\": \"1995-05-10\", \"phone\": \"0300-0000000\", \"email\": \"postman@test.pk\", \"allergies\": \"None\" }",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Update patient (paste id)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Prefer", "value": "return=representation" }
            ],
            "url": "{{base_url}}/rest/v1/patients?id=eq.PASTE_ID_HERE",
            "body": {
              "mode": "raw",
              "raw": "{ \"phone\": \"0301-9999999\" }",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete patient (paste id)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Prefer", "value": "return=representation" }
            ],
            "url": "{{base_url}}/rest/v1/patients?id=eq.PASTE_ID_HERE"
          }
        }
      ]
    },
