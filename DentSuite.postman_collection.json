            "url": "{{base_url}}/storage/v1/object/list/documents",
            "body": {
              "mode": "raw",
              "raw": "{ \"prefix\": \"{{patient_id}}\", \"limit\": 100 }",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Delete file",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/storage/v1/object/documents/{{patient_id}}/postman-test.png"
          }
        },
        {
          "name": "Upload to imaging (403 as receptionist — by design)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "image/png" }
            ],
            "url": "{{base_url}}/storage/v1/object/imaging/{{patient_id}}/postman-xray.png",
            "body": { "mode": "file", "file": { "src": "" } }
          }
        }
      ]
    },
    {
      "name": "RLS demos (sign in as receptionist first)",
      "item": [
        {
          "name": "Expenses → 200 but [] (hidden)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{base_url}}/rest/v1/expenses"
          }
        },
        {
          "name": "Insert prescription → 403 code 42501",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/rest/v1/prescriptions",
            "body": {
              "mode": "raw",
              "raw": "{ \"patient_id\": \"{{patient_id}}\", \"medication\": \"Should be refused\" }",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "No token at all → every table returns []",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{anon_key}}" }
            ],
            "url": "{{base_url}}/rest/v1/patients"
          }
        }
      ]
    }
  ]
}
